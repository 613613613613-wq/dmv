{
  "name": "dealguard",
  "private": true,
  "version": "1.0.0",
  "description": "Deal Guard — real-time negotiation red flags and fact cards, grounded in your own deal terms.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:screenshots": "playwright test --project=store-screenshots",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run test && npm run build",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "assets": "node scripts/make-icon.mjs && npx @capacitor/assets generate --ios --android --iconBackgroundColor '#07090d' --iconBackgroundColorDark '#07090d' --splashBackgroundColor '#07090d' --splashBackgroundColorDark '#07090d'",
    "mock-hud": "node scripts/mock-hud-server.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@revenuecat/purchases-capacitor": "^13.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.47",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
