# fastlane Fastfile — Deal Guard (Capacitor 8; web bundle in ../dist, native projects in ../ios and ../android)
#
# Run from the dealguard/ folder:
#   bundle exec fastlane ios beta          # TestFlight
#   bundle exec fastlane ios release       # App Store upload, no auto-submit
#   bundle exec fastlane android internal  # Play internal testing track
#   bundle exec fastlane android production# Play production track (draft; roll out in the console)
#
# Required environment (see fastlane/README.md):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT   App Store Connect API key (.p8 contents, base64 or raw)
#   MATCH_GIT_URL, MATCH_PASSWORD               fastlane match certificate repo
#   PLAY_JSON_KEY                               Play service-account JSON (contents)
#   VITE_RC_IOS_KEY, VITE_RC_ANDROID_KEY        RevenueCat public SDK keys (optional; empty disables purchasing)

fastlane_version "2.220.0"
default_platform(:ios)

APP_ID = "com.shlomo.dealguard"
IOS_PROJECT = "ios/App/App.xcodeproj"  # Capacitor 8 uses Swift Package Manager: no .xcworkspace, no CocoaPods
IOS_SCHEME = "App"
ANDROID_DIR = "android/"
AAB_PATH = "android/app/build/outputs/bundle/release/app-release.aab"

# Web bundle: install, typecheck, unit tests, build, then push into the native shells.
private_lane :web_check do |options|
  platform = options[:platform] # "ios" | "android"
  sh("cd .. && npm ci && npm run check")
  sh("cd .. && npx cap sync #{platform}")
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: ENV.fetch("ASC_KEY_BASE64", "true") == "true",
    in_house: false
  )
end

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  # match(readonly) installs the certificate + profile; this pins the project to
  # them so a headless archive never depends on Xcode's automatic signing.
  private_lane :sign_ios do
    update_code_signing_settings(
      path: IOS_PROJECT,
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_ID,
      profile_name: ENV.fetch("sigh_#{APP_ID}_appstore_profile-name"),
      build_configurations: ["Release"]
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    web_check(platform: "ios")
    api_key = asc_api_key
    match(type: "appstore", app_identifier: APP_ID, readonly: true, api_key: api_key)
    sign_ios
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"] || latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID) + 1,
      xcodeproj: "ios/App/App.xcodeproj"
    )
    build_app(
      project: IOS_PROJECT,
      scheme: IOS_SCHEME,
      export_method: "app-store",
      clean: true,
      output_directory: "fastlane/build/ios"
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: File.read("metadata/ios/en-US/release_notes.txt")
    )
  end

  desc "Build, upload binary + metadata + screenshots to App Store Connect. Does NOT submit for review."
  lane :release do
    web_check(platform: "ios")
    api_key = asc_api_key
    match(type: "appstore", app_identifier: APP_ID, readonly: true, api_key: api_key)
    sign_ios
    build_app(
      project: IOS_PROJECT,
      scheme: IOS_SCHEME,
      export_method: "app-store",
      clean: true,
      output_directory: "fastlane/build/ios"
    )
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      metadata_path: "fastlane/metadata/ios",
      screenshots_path: "fastlane/screenshots",
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end

# Pass exactly one of json_key_data / json_key to supply.
def play_json_key
  if ENV["PLAY_JSON_KEY"].to_s.empty?
    { json_key: ENV.fetch("PLAY_JSON_KEY_FILE") }
  else
    { json_key_data: ENV["PLAY_JSON_KEY"] }
  end
end

platform :android do
  desc "Build release AAB and upload to the Play internal testing track"
  lane :internal do
    web_check(platform: "android")
    gradle(task: "bundle", build_type: "Release", project_dir: ANDROID_DIR)
    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      **play_json_key,
      package_name: APP_ID,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end

  desc "Build release AAB and upload to the Play production track as a draft, with metadata and screenshots"
  lane :production do
    web_check(platform: "android")
    gradle(task: "bundle", build_type: "Release", project_dir: ANDROID_DIR)
    upload_to_play_store(
      track: "production",
      aab: AAB_PATH,
      **play_json_key,
      package_name: APP_ID,
      metadata_path: "fastlane/metadata/android",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: false,
      release_status: "draft"
    )
  end
end
