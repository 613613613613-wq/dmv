# fastlane Appfile — Deal Guard
# Secrets come from the environment (CI secrets or fastlane/.env, which is gitignored).

app_identifier("com.shlomo.dealguard")
apple_id(ENV["APPLE_ID"])             # Apple ID email used for App Store Connect (only needed without an API key)
itc_team_id(ENV["ASC_TEAM_ID"])       # App Store Connect team id
team_id(ENV["APPLE_TEAM_ID"])         # Developer Portal team id

for_platform :android do
  package_name("com.shlomo.dealguard")
  json_key_file(ENV["PLAY_JSON_KEY_FILE"]) # optional: path alternative to PLAY_JSON_KEY contents
end
